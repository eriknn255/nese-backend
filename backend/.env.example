# Copie pra .env e ajuste se precisar. Sem .env, os defaults do db.js/server.js já funcionam.
PORT=3000
DB_PATH=./data/mase.db

# Client ID do Google OAuth (tipo "Web application"), criado em
# https://console.cloud.google.com/apis/credentials — mesmo Client ID
# que vai no front, em 01-constantes.js (GOOGLE_CLIENT_ID). Sem isso, POST
# /usuarios/entrar-google responde 500.
GOOGLE_CLIENT_ID=131029563564-25fb10maaduh4ki6nu8pspqohp8kg49c.apps.googleusercontent.com

# Segredo usado pra ASSINAR o token de sessão (JWT) que entrar-google
# emite e que identidade.js verifica em toda rota protegida. Não é o
# mesmo tipo de coisa que o GOOGLE_CLIENT_ID acima — esse aqui é só nosso,
# nunca deve ir pro front nem pro Git. Sem ele, /entrar-google responde
# 500 e nenhuma rota protegida autentica ninguém. O valor abaixo já é
# aleatório e serve, mas gere o seu com `openssl rand -hex 32` se for pra
# produção de verdade.
JWT_SECRET=6b12c097e6eabfb12a6d5ead43aed23b3b47807324f21b80e709d96429fb21f2

# Pasta onde ficam as fotos servidas em /img/... (perfil, capa, serviço).
IMG_DIR=./public/img

ADMIN_TOKEN=algumacoisagrandeealeatoria

# Origens liberadas a chamar a API via CORS, separadas por vírgula (ex:
# "https://nese.app,https://admin.nese.app"). Sem isso configurado, a API
# libera QUALQUER origem (comportamento antigo) e avisa no console — ver
# server.js. Defina isso antes de ir pra produção de verdade.
CORS_ORIGIN=

# Quantos dias de request_logs ficam guardados antes do job de limpeza
# apagar (ver jobs/limparRequestLogs.js, roda 1x/dia). NÃO afeta
# log_cadastros nem auditoria_contas — essas duas são histórico/auditoria
# e nunca são apagadas por TTL.
LOG_RETENCAO_DIAS=30
